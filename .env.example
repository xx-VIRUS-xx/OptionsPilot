# ============================================================
# AUTO INCOME BOT — Indian Options Trading
# ============================================================
# Copy this to .env and fill your values:  cp .env.example .env

# ── Broker: Angel One SmartAPI (free) ──
BROKER=angel
ANGEL_API_KEY=your_api_key
ANGEL_CLIENT_ID=your_client_id
ANGEL_PASSWORD=your_password
ANGEL_TOTP_SECRET=your_totp_secret

# ── Trading Mode ──
# "paper" = simulated (no real money), "live" = real trades
TRADING_MODE=paper

# ── Instruments ──
INSTRUMENTS=BANKNIFTY,NIFTY

# ── Telegram Notifications ──
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── Capital & Risk ──
STARTING_CAPITAL=5000
MAX_RISK_PER_TRADE_PCT=20
MAX_TRADES_PER_DAY=5
MAX_LOSS_PER_DAY_PCT=30
STOP_LOSS_PCT=30
TARGET_PCT=50
TRAILING_SL_PCT=20

# ── Market Timing ──
NO_ENTRY_AFTER_HOUR=14
NO_ENTRY_AFTER_MINUTE=45
SQUARE_OFF_HOUR=15
SQUARE_OFF_MINUTE=15

# ── Goal ──
GOAL_AMOUNT=10000000

# ── Dashboard ──
DASHBOARD_PORT=8080
